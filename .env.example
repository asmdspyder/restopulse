# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wastesaas

# JWT Secret for Session Cookies
AUTH_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long

# Razorpay Configuration (Monthly: ₹399, Yearly: ₹3,999)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WasteFlow

# Super Admin Credentials
ADMIN_EMAIL=admin@wasteflow.io
ADMIN_PASSWORD=AdminSecurePassword123!
